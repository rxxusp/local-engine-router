{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rxxusp/local-engine-router/config.schema.json",
  "title": "local-engine-router configuration",
  "description": "Configuration schema for local-engine-router (local-engine-router). Unknown keys are accepted with a warning for forward compatibility.",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "default": "127.0.0.1"
    },
    "port": {
      "type": "integer",
      "default": 8077,
      "minimum": 1,
      "maximum": 65535
    },
    "api_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "log_file": {
      "type": "string",
      "default": "./logs/router.log"
    },
    "log_level": {
      "type": "string",
      "default": "INFO"
    },
    "state_file": {
      "type": "string",
      "default": "./state.json"
    },
    "swap_keepalive_interval_s": {
      "type": "number",
      "default": 5.0,
      "exclusiveMinimum": 0
    },
    "swap_keepalive_enabled": {
      "type": "boolean",
      "default": true
    },
    "drain_timeout_s": {
      "type": "number",
      "default": 30.0,
      "minimum": 0
    },
    "swap_memory_settle_timeout_s": {
      "type": "number",
      "default": 25.0,
      "minimum": 0
    },
    "upstream_connect_timeout_s": {
      "type": "number",
      "default": 15.0,
      "exclusiveMinimum": 0
    },
    "allow_destructive_ollama_api": {
      "type": "boolean",
      "default": false
    },
    "aliases": {
      "type": "object",
      "additionalProperties": true
    },
    "routing_mode": {
      "type": "string",
      "enum": [
        "manual",
        "smart"
      ],
      "default": "smart",
      "description": "'smart' (default): the picker chooses the best local model for smart aliases / cloud names / unknown ids. 'manual': exact model-id routing only."
    },
    "smart": {
      "type": "object",
      "description": "Smart model-picker settings; active when routing_mode is 'smart' (the default). Absent = all defaults.",
      "properties": {
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "smart",
            "auto",
            "default"
          ],
          "description": "Request model ids that always trigger smart selection."
        },
        "policy": {
          "type": "string",
          "default": "balanced",
          "description": "Active scoring policy: balanced | fast | quality | economy, or a custom name defined under policies."
        },
        "policies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "context": {
                "type": "number",
                "minimum": 0
              },
              "quality": {
                "type": "number",
                "minimum": 0
              },
              "reliability": {
                "type": "number",
                "minimum": 0
              },
              "residency": {
                "type": "number",
                "minimum": 0
              },
              "speed": {
                "type": "number",
                "minimum": 0
              },
              "swap_cost": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "description": "Custom named policies (weight presets)."
        },
        "weights": {
          "type": "object",
          "properties": {
            "context": {
              "type": "number",
              "minimum": 0
            },
            "quality": {
              "type": "number",
              "minimum": 0
            },
            "reliability": {
              "type": "number",
              "minimum": 0
            },
            "residency": {
              "type": "number",
              "minimum": 0
            },
            "speed": {
              "type": "number",
              "minimum": 0
            },
            "swap_cost": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "description": "Scoring-component weight overrides, merged over the active policy's weights."
        },
        "catch_cloud_models": {
          "type": "boolean",
          "default": true
        },
        "catch_unknown_models": {
          "type": "boolean",
          "default": true
        },
        "override_exact_model_ids": {
          "type": "boolean",
          "default": false
        },
        "swap_margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.08,
          "description": "Score advantage a non-resident model needs over the best resident candidate to justify an engine swap."
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.25
        },
        "swap_cost_horizon_s": {
          "type": "number",
          "minimum": 0,
          "default": 180.0
        },
        "retry": {
          "type": "object",
          "properties": {
            "same_model_reload": {
              "type": "boolean",
              "default": true
            },
            "fall_forward": {
              "type": "boolean",
              "default": true
            },
            "max_fallbacks": {
              "type": "integer",
              "minimum": 0,
              "default": 2
            },
            "failure_threshold": {
              "type": "integer",
              "minimum": 0,
              "default": 3
            },
            "cooldown_s": {
              "type": "number",
              "minimum": 0,
              "default": 120.0
            }
          },
          "additionalProperties": false
        },
        "benchmarks": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "allow_network": {
              "type": "boolean",
              "default": false
            },
            "cache_ttl_s": {
              "type": "number",
              "minimum": 0,
              "default": 0.0
            }
          },
          "additionalProperties": false
        },
        "calibration_enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "ds4": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "base_url": {
          "type": "string",
          "default": "http://172.17.0.1:8099"
        },
        "control": {
          "type": "string",
          "default": "systemd-user"
        },
        "systemd_user_unit": {
          "type": "string",
          "default": "ds4.service"
        },
        "serve_script": {
          "type": "string",
          "default": ""
        },
        "process_pattern": {
          "type": "string",
          "default": "ds4/ds4-server"
        },
        "health_path": {
          "type": "string",
          "default": "/v1/models"
        },
        "start_timeout_s": {
          "type": "number",
          "default": 240.0
        },
        "stop_timeout_s": {
          "type": "number",
          "default": 45.0
        },
        "log_file": {
          "type": "string",
          "default": "./logs/ds4-server.log"
        },
        "control_headers": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ollama": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "base_url": {
          "type": "string",
          "default": "http://127.0.0.1:11434"
        },
        "health_path": {
          "type": "string",
          "default": "/api/tags"
        },
        "unload_timeout_s": {
          "type": "number",
          "default": 60.0
        },
        "systemd_unit": {
          "type": "string",
          "default": "ollama.service"
        },
        "tags_cache_ttl_s": {
          "type": "number",
          "default": 30.0
        },
        "control_headers": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "engines": {
      "type": "object",
      "description": "Optional generic engine table: engine_key -> engine settings. When present it is the sole source of engines and the ds4:/ollama: sections are ignored.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "ds4"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "base_url": {
                "type": "string",
                "default": "http://172.17.0.1:8099"
              },
              "control": {
                "type": "string",
                "default": "systemd-user"
              },
              "systemd_user_unit": {
                "type": "string",
                "default": "ds4.service"
              },
              "serve_script": {
                "type": "string",
                "default": ""
              },
              "process_pattern": {
                "type": "string",
                "default": "ds4/ds4-server"
              },
              "health_path": {
                "type": "string",
                "default": "/v1/models"
              },
              "start_timeout_s": {
                "type": "number",
                "default": 240.0
              },
              "stop_timeout_s": {
                "type": "number",
                "default": 45.0
              },
              "log_file": {
                "type": "string",
                "default": "./logs/ds4-server.log"
              },
              "control_headers": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": true,
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "ollama"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "base_url": {
                "type": "string",
                "default": "http://127.0.0.1:11434"
              },
              "health_path": {
                "type": "string",
                "default": "/api/tags"
              },
              "unload_timeout_s": {
                "type": "number",
                "default": 60.0
              },
              "systemd_unit": {
                "type": "string",
                "default": "ollama.service"
              },
              "tags_cache_ttl_s": {
                "type": "number",
                "default": 30.0
              },
              "control_headers": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": true,
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "generic_process"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "base_url": {
                "type": "string",
                "default": ""
              },
              "start_cmd": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "env": {
                "type": "object",
                "additionalProperties": true
              },
              "cwd": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ready_path": {
                "type": "string",
                "default": "/health"
              },
              "ready_check": {
                "type": "string",
                "default": ""
              },
              "start_timeout_s": {
                "type": "number",
                "default": 300.0
              },
              "stop_signal": {
                "type": "string",
                "default": "SIGTERM"
              },
              "stop_timeout_s": {
                "type": "number",
                "default": 30.0
              },
              "process_pattern": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "log_file": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "control_headers": {
                "type": "object",
                "additionalProperties": true
              },
              "discover_models": {
                "type": "boolean",
                "default": false
              },
              "served_models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tags_cache_ttl_s": {
                "type": "number",
                "default": 30.0
              }
            },
            "additionalProperties": true,
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "api_swap"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "base_url": {
                "type": "string",
                "default": ""
              },
              "health_path": {
                "type": "string",
                "default": "/v1/models"
              },
              "ready_check": {
                "type": "string",
                "default": ""
              },
              "unload_path": {
                "type": "string",
                "default": ""
              },
              "unload_method": {
                "type": "string",
                "default": "POST"
              },
              "unload_body": {
                "type": "object",
                "additionalProperties": true
              },
              "load_path": {
                "type": "string",
                "default": ""
              },
              "load_method": {
                "type": "string",
                "default": "POST"
              },
              "load_body": {
                "type": "object",
                "additionalProperties": true
              },
              "load_timeout_s": {
                "type": "number",
                "default": 120.0
              },
              "loaded_path": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "loaded_models_key": {
                "type": "string",
                "default": "models"
              },
              "loaded_name_key": {
                "type": "string",
                "default": "name"
              },
              "loaded_filter": {
                "type": "string",
                "default": ""
              },
              "loaded_id_key": {
                "type": "string",
                "default": ""
              },
              "unload_timeout_s": {
                "type": "number",
                "default": 60.0
              },
              "systemd_unit": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tags_cache_ttl_s": {
                "type": "number",
                "default": 30.0
              },
              "control_headers": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": true,
            "required": [
              "type"
            ]
          }
        ]
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "engine": {
            "type": "string",
            "pattern": "\\S"
          },
          "display_name": {
            "type": "string"
          },
          "context_length": {
            "type": "integer",
            "default": 131072
          },
          "disable_thinking_below_max_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Inject chat_template_kwargs.enable_thinking=false on chat requests whose max_tokens is below this, so a small budget isn't eaten by the reasoning channel. null/omitted = off."
          },
          "quality_tier": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional coarse quality tier 1 (worst) .. 5 (best) for the smart picker; omitted = derive from benchmark priors."
          },
          "speed_tier": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional coarse speed tier 1 (slowest) .. 5 (fastest) for the smart picker; omitted = derive from model size."
          },
          "memory_gb": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Approximate loaded memory footprint in GB."
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "code_editing",
                "coding",
                "embedding",
                "general",
                "json_structured",
                "long_context",
                "math",
                "reasoning",
                "summarization",
                "tool_use",
                "vision",
                "writing"
              ]
            },
            "description": "What the model can do; empty = general chat model. Include 'embedding' / 'vision' so the smart picker matches request shape."
          },
          "strengths": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "description": "Per-capability score overrides (0..1) that beat benchmark priors for the smart picker."
          },
          "smart_enabled": {
            "type": "boolean",
            "default": true,
            "description": "Set false to exclude this model from smart selection (it stays routable by its exact id)."
          }
        },
        "required": [
          "id",
          "engine"
        ],
        "additionalProperties": true
      }
    },
    "discover": {
      "type": "object",
      "description": "Optional global model-discovery settings. Absent or omitted = all defaults (discovery off). Discovery augments the static models: list and is entirely opt-in per engine via discover_models: true.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "collision": {
          "type": "string",
          "enum": [
            "config_order"
          ],
          "default": "config_order"
        },
        "refresh_interval_s": {
          "type": "number",
          "default": 300.0
        },
        "state_ttl_s": {
          "type": "number",
          "default": 2592000.0
        },
        "port_probe": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
